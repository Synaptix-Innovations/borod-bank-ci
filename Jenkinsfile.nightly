#!/usr/bin/env groovy

/*
 * Borod Bank — Nightly Regression Pipeline
 *
 * Schedule: Daily at 2:00 AM (cron: H 2 * * *)
 *
 * 13 Stages:
 *  1. Checkout
 *  2. Unit Tests + Coverage (JaCoCo 70%)
 *  3. Integration Tests (MySQL sidecar)
 *  4. Architecture Tests (ArchUnit)
 *  5. Mutation Testing (PIT 60%)
 *  6. OWASP Dependency Check
 *  7. License Compliance
 *  8. Performance Test (k6)
 *  9. AI Nightly Analysis
 * 10. Smoke Tests (conditional — app reachable)
 * 11. DAST Scan / ZAP (conditional — app reachable)
 * 12. Pen Test / Nuclei (conditional — app reachable)
 * 13. Push Metrics (Pushgateway → Prometheus → Grafana)
 *
 * 10 of 13 stages work without a running cluster.
 * Smoke Tests + ZAP + Nuclei gracefully skip when app is offline.
 */

pipeline {
    agent {
        kubernetes {
            yaml """
apiVersion: v1
kind: Pod
metadata:
  labels:
    jenkins: nightly-agent
spec:
  serviceAccountName: jenkins
  containers:

  - name: jnlp
    image: jenkins/inbound-agent:3261.v9c670a_4748a_9-1
    resources:
      requests:
        cpu: 50m
        memory: 128Mi
      limits:
        cpu: 500m
        memory: 512Mi

  - name: maven
    image: maven:3.9-eclipse-temurin-17
    command: [cat]
    tty: true
    resources:
      requests:
        cpu: 500m
        memory: 1Gi
      limits:
        cpu: 2000m
        memory: 3Gi
    volumeMounts:
    - name: maven-cache
      mountPath: /root/.m2

  - name: mysql-it
    image: mysql:8.0
    env:
      - name: MYSQL_DATABASE
        value: testdb
      - name: MYSQL_ROOT_PASSWORD
        value: testpassword
    resources:
      requests:
        cpu: 25m
        memory: 256Mi
      limits:
        cpu: 500m
        memory: 512Mi

  - name: tools
    image: python:3.12-slim
    command:
      - /bin/sh
      - -c
      - |
        pip install --quiet requests 2>/dev/null
        apt-get update -qq && apt-get install -y -qq curl jq > /dev/null 2>&1
        sleep infinity
    tty: true
    resources:
      requests:
        cpu: 50m
        memory: 128Mi
      limits:
        cpu: 200m
        memory: 256Mi

  - name: k6
    image: grafana/k6:latest
    command: [cat]
    tty: true
    resources:
      requests:
        cpu: 100m
        memory: 128Mi
      limits:
        cpu: 500m
        memory: 512Mi

  - name: zap
    image: ghcr.io/zaproxy/zaproxy:stable
    command: [cat]
    tty: true
    resources:
      requests:
        cpu: 250m
        memory: 512Mi
      limits:
        cpu: 500m
        memory: 1Gi

  - name: nuclei
    image: projectdiscovery/nuclei:v3.7.0
    command: [cat]
    tty: true
    resources:
      requests:
        cpu: 100m
        memory: 256Mi
      limits:
        cpu: 500m
        memory: 512Mi

  volumes:
  - name: maven-cache
    persistentVolumeClaim:
      claimName: maven-cache
"""
        }
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '30'))
        timeout(time: 2, unit: 'HOURS')
        timestamps()
        ansiColor('xterm')
    }

    environment {
        APP_URL         = 'https://app.vladinnovations.info'
        ZAP_PORT        = '8090'
        SLACK_CHANNEL   = '#nightly-reports'
        PUSHGATEWAY_URL = 'http://pushgateway-service.monitoring:9091'
        AIOPS_GATEWAY   = 'http://aiops-gateway.aiops.svc.cluster.local:8080'
    }

    stages {

        // ── Stage 1: Checkout ──────────────────────────────────────────────
        stage('Checkout') {
            steps {
                checkout scm
                script {
                    env.GIT_COMMIT_SHORT = sh(
                        script: "git rev-parse --short HEAD",
                        returnStdout: true
                    ).trim()
                    env.BUILD_TIME = sh(
                        script: "date '+%Y-%m-%d %H:%M:%S'",
                        returnStdout: true
                    ).trim()
                    env.BUILD_START_EPOCH = sh(
                        script: "date +%s",
                        returnStdout: true
                    ).trim()
                }
            }
        }

        // ── Stage 2: Unit Tests + Coverage ─────────────────────────────────
        stage('Unit Tests + Coverage') {
            steps {
                container('maven') {
                    timeout(time: 10, unit: 'MINUTES') {
                        sh 'mvn test -q'
                    }
                    script {
                        // Parse coverage from JaCoCo XML
                        def jacocoXml = 'target/site/jacoco/jacoco.xml'
                        if (fileExists(jacocoXml)) {
                            def coverage = sh(
                                script: """
                                    python3 -c "
import xml.etree.ElementTree as ET
tree = ET.parse('${jacocoXml}')
for c in tree.findall('.//counter'):
    if c.get('type') == 'LINE':
        m = int(c.get('missed', 0))
        cv = int(c.get('covered', 0))
        print(round(cv * 100.0 / (m + cv), 1) if (m + cv) > 0 else 0)
        break
" 2>/dev/null || echo "0"
                                """,
                                returnStdout: true
                            ).trim()
                            env.COVERAGE_PERCENT = coverage
                        } else {
                            env.COVERAGE_PERCENT = '0'
                        }

                        // Parse unit test counts from surefire
                        def unitTotal = sh(
                            script: "grep -r 'tests=' target/surefire-reports/*.xml 2>/dev/null | head -1 | sed 's/.*tests=\"\\([0-9]*\\)\".*/\\1/' || echo '0'",
                            returnStdout: true
                        ).trim()
                        def unitFailed = sh(
                            script: "grep -r 'failures=' target/surefire-reports/*.xml 2>/dev/null | head -1 | sed 's/.*failures=\"\\([0-9]*\\)\".*/\\1/' || echo '0'",
                            returnStdout: true
                        ).trim()
                        env.UNIT_TOTAL = unitTotal
                        env.UNIT_FAILED = unitFailed

                        echo "Coverage: ${env.COVERAGE_PERCENT}% | Unit Tests: ${unitTotal} total, ${unitFailed} failed"
                    }
                }
            }
            post {
                always {
                    publishHTML(target: [
                        allowMissing: true,
                        alwaysLinkToLastBuild: true,
                        keepAll: true,
                        reportDir: 'target/site/jacoco',
                        reportFiles: 'index.html',
                        reportName: 'JaCoCo Coverage Report'
                    ])
                }
            }
        }

        // ── Stage 3: Integration Tests ─────────────────────────────────────
        stage('Integration Tests') {
            steps {
                container('maven') {
                    timeout(time: 10, unit: 'MINUTES') {
                        sh '''
                            echo "Waiting for MySQL sidecar..."
                            for i in $(seq 1 30); do
                                (echo > /dev/tcp/localhost/3306) 2>/dev/null && echo "MySQL ready" && break
                                echo "Attempt $i/30 — waiting 2s..."
                                sleep 2
                            done

                            mvn test \
                              -Dtest="*IT" \
                              -Dspring.profiles.active=it \
                              -DfailIfNoTests=false \
                              -Djacoco.skip=true \
                              -q
                        '''
                    }
                    script {
                        // Parse IT test counts
                        def itTotal = sh(
                            script: """
                                find target/surefire-reports -name 'TEST-*IT.xml' -exec grep -l 'testsuite' {} \\; 2>/dev/null | \
                                xargs grep -h 'tests=' 2>/dev/null | \
                                sed 's/.*tests=\"\\([0-9]*\\)\".*/\\1/' | \
                                awk '{s+=\$1} END {print s+0}'
                            """,
                            returnStdout: true
                        ).trim()
                        def itFailed = sh(
                            script: """
                                find target/surefire-reports -name 'TEST-*IT.xml' -exec grep -l 'testsuite' {} \\; 2>/dev/null | \
                                xargs grep -h 'failures=' 2>/dev/null | \
                                sed 's/.*failures=\"\\([0-9]*\\)\".*/\\1/' | \
                                awk '{s+=\$1} END {print s+0}'
                            """,
                            returnStdout: true
                        ).trim()
                        env.IT_TOTAL = itTotal
                        env.IT_FAILED = itFailed
                        echo "Integration Tests: ${itTotal} total, ${itFailed} failed"
                    }
                }
            }
        }

        // ── Stage 4: Architecture Tests ────────────────────────────────────
        stage('Architecture Tests') {
            steps {
                catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
                    container('maven') {
                        timeout(time: 5, unit: 'MINUTES') {
                            sh 'mvn test -Dtest="ArchitectureTest" -DfailIfNoTests=false -Djacoco.skip=true -q'
                        }
                    }
                }
            }
        }

        // ── Stage 5: Mutation Testing (PIT) ────────────────────────────────
        stage('Mutation Testing (PIT)') {
            steps {
                container('maven') {
                    timeout(time: 15, unit: 'MINUTES') {
                        catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
                            sh 'mvn org.pitest:pitest-maven:mutationCoverage -q'
                        }
                    }
                    script {
                        // Parse mutation score from XML report
                        def mutationsXml = 'target/pit-reports/mutations.xml'
                        if (fileExists(mutationsXml)) {
                            def mutScore = sh(
                                script: """
                                    python3 -c "
import xml.etree.ElementTree as ET
tree = ET.parse('${mutationsXml}')
mutations = tree.findall('.//mutation')
total = len(mutations)
killed = len([m for m in mutations if m.get('status') == 'KILLED'])
print(round(killed * 100.0 / total, 1) if total > 0 else 0)
" 2>/dev/null || echo "0"
                                """,
                                returnStdout: true
                            ).trim()
                            env.MUTATION_SCORE = mutScore
                        } else {
                            env.MUTATION_SCORE = '0'
                        }
                        echo "Mutation Score: ${env.MUTATION_SCORE}%"
                    }
                }
            }
            post {
                always {
                    publishHTML(target: [
                        allowMissing: true,
                        alwaysLinkToLastBuild: true,
                        keepAll: true,
                        reportDir: 'target/pit-reports',
                        reportFiles: 'index.html',
                        reportName: 'PIT Mutation Report'
                    ])
                }
            }
        }

        // ── Stage 6: OWASP Dependency Check (skipped — too slow for dev cycles) ─
        stage('OWASP Dependency Check') {
            when { expression { return false } }
            steps {
                catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
                    container('maven') {
                        timeout(time: 25, unit: 'MINUTES') {
                            sh '''
                                mvn org.owasp:dependency-check-maven:check \
                                  -DfailBuildOnCVSS=7 \
                                  -DsuppressionFile=dependency-check-suppressions.xml \
                                  -Dformats=HTML,JSON
                            '''
                        }
                        script {
                            // Parse CVE counts from JSON report
                            def dcJson = 'target/dependency-check-report.json'
                            if (fileExists(dcJson)) {
                                def counts = sh(
                                    script: """
                                        python3 -c "
import json
with open('${dcJson}') as f:
    data = json.load(f)
deps = data.get('dependencies', [])
crit = high = med = 0
for d in deps:
    for v in d.get('vulnerabilities', []):
        s = v.get('cvssv3', {}).get('baseScore', v.get('cvssv2', {}).get('score', 0))
        if s >= 9: crit += 1
        elif s >= 7: high += 1
        elif s >= 4: med += 1
print(f'{crit} {high} {med}')
" 2>/dev/null || echo "0 0 0"
                                    """,
                                    returnStdout: true
                                ).trim().split(' ')
                                env.OWASP_CRITICAL = counts[0]
                                env.OWASP_HIGH = counts[1]
                                env.OWASP_MEDIUM = counts[2]
                            } else {
                                env.OWASP_CRITICAL = 'N/A'
                                env.OWASP_HIGH = 'N/A'
                                env.OWASP_MEDIUM = 'N/A'
                            }
                            echo "OWASP CVEs: critical=${env.OWASP_CRITICAL} high=${env.OWASP_HIGH} medium=${env.OWASP_MEDIUM}"
                        }
                    }
                }
            }
            post {
                always {
                    publishHTML(target: [
                        allowMissing: true,
                        alwaysLinkToLastBuild: true,
                        keepAll: true,
                        reportDir: 'target',
                        reportFiles: 'dependency-check-report.html',
                        reportName: 'OWASP Dependency Check Report'
                    ])
                }
            }
        }

        // ── Stage 7: License Compliance ────────────────────────────────────
        stage('License Compliance') {
            steps {
                container('maven') {
                    timeout(time: 5, unit: 'MINUTES') {
                        sh 'mvn license:aggregate-third-party-report -q'
                    }
                    script {
                        // Check for forbidden licenses (GPL, AGPL)
                        def licenseStatus = sh(
                            script: """
                                if grep -ri 'GNU General Public License\\|AGPL\\|GPL-2.0\\|GPL-3.0' \
                                    target/site/aggregate-third-party-report.html 2>/dev/null | \
                                    grep -v 'LGPL' | grep -q 'GPL'; then
                                    echo 'FAIL'
                                else
                                    echo 'PASS'
                                fi
                            """,
                            returnStdout: true
                        ).trim()
                        env.LICENSE_STATUS = licenseStatus
                        echo "License Compliance: ${licenseStatus}"
                        if (licenseStatus == 'FAIL') {
                            unstable("Forbidden license (GPL/AGPL) detected in dependencies")
                        }
                    }
                }
            }
            post {
                always {
                    publishHTML(target: [
                        allowMissing: true,
                        alwaysLinkToLastBuild: true,
                        keepAll: true,
                        reportDir: 'target/site',
                        reportFiles: 'aggregate-third-party-report.html',
                        reportName: 'License Compliance Report'
                    ])
                }
            }
        }

        // ── Stage 8: Performance Test (k6) — runs against live app ──────────
        stage('Performance Test (k6)') {
            when {
                expression {
                    def status = sh(
                        script: "curl -sf --max-time 5 ${APP_URL}/actuator/health > /dev/null 2>&1 && echo 'true' || echo 'false'",
                        returnStdout: true
                    ).trim()
                    if (status != 'true') { echo "k6 skipped — app not reachable" }
                    return status == 'true'
                }
            }
            steps {
                timeout(time: 3, unit: 'MINUTES') {
                    // Run k6 load test against app via internal cluster service
                    container('tools') {
                        sh '''
                            if ! command -v k6 > /dev/null 2>&1; then
                                curl -sfL https://github.com/grafana/k6/releases/download/v0.54.0/k6-v0.54.0-linux-amd64.tar.gz \
                                  | tar xz --strip-components=1 -C /usr/local/bin k6-v0.54.0-linux-amd64/k6
                            fi
                            k6 run \
                              --out json=/tmp/k6-results.json \
                              -e BASE_URL=http://borod-bank-service.borod-bank:80 \
                              src/test/resources/load-test.js \
                              || true
                        '''
                    }

                    // Step 3: Parse k6 results
                    container('tools') {
                        script {
                            def k6Metrics = sh(
                                script: """
                                    python3 -c "
import json, sys
p95 = rps = err = 0
lines = open('/tmp/k6-results.json').readlines() if __import__('os').path.exists('/tmp/k6-results.json') else []
durations = []
errors = total = 0
for line in lines:
    try:
        d = json.loads(line)
        if d.get('type') == 'Point':
            metric = d.get('metric', '')
            val = d.get('data', {}).get('value', 0)
            if metric == 'http_req_duration':
                durations.append(val)
            elif metric == 'http_req_failed':
                total += 1
                if val > 0: errors += 1
    except: pass
if durations:
    durations.sort()
    idx = int(len(durations) * 0.95)
    p95 = round(durations[idx], 1)
    rps = round(len(durations) / 30.0, 1)
err = round(errors * 100.0 / total, 1) if total > 0 else 0
print(f'{p95} {rps} {err}')
" 2>/dev/null || echo "0 0 0"
                                """,
                                returnStdout: true
                            ).trim().split(' ')
                            env.K6_P95 = k6Metrics[0]
                            env.K6_RPS = k6Metrics[1]
                            env.K6_ERROR_RATE = k6Metrics[2]
                            echo "k6 Results: p95=${env.K6_P95}ms, RPS=${env.K6_RPS}, errors=${env.K6_ERROR_RATE}%"

                            if (env.K6_P95.toFloat() > 2000) {
                                unstable("k6 p95 response time ${env.K6_P95}ms exceeds 2000ms threshold")
                            }
                        }
                    }
                }
            }
        }

        // ── Stage 9: AI Nightly Analysis ───────────────────────────────────
        stage('AI Nightly Analysis') {
            steps {
                catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                    container('tools') {
                        timeout(time: 2, unit: 'MINUTES') {
                            script {
                                def summary = """
Nightly Build #${env.BUILD_NUMBER} (${env.GIT_COMMIT_SHORT})
- Unit Tests: ${env.UNIT_TOTAL ?: 'N/A'} total, ${env.UNIT_FAILED ?: 'N/A'} failed
- IT Tests: ${env.IT_TOTAL ?: 'N/A'} total, ${env.IT_FAILED ?: 'N/A'} failed
- Coverage: ${env.COVERAGE_PERCENT ?: 'N/A'}%
- Mutation Score: ${env.MUTATION_SCORE ?: 'N/A'}%
- OWASP CVEs: critical=${env.OWASP_CRITICAL ?: 'N/A'} high=${env.OWASP_HIGH ?: 'N/A'} medium=${env.OWASP_MEDIUM ?: 'N/A'}
- License: ${env.LICENSE_STATUS ?: 'N/A'}
- k6 p95: ${env.K6_P95 ?: 'N/A'}ms, RPS: ${env.K6_RPS ?: 'N/A'}, errors: ${env.K6_ERROR_RATE ?: 'N/A'}%
Analyze quality trends and provide 3-4 actionable recommendations.
"""
                                writeFile file: 'ai-summary.txt', text: summary

                                sh """
                                    GATEWAY_URL="${env.AIOPS_GATEWAY}"

                                    # Health check
                                    GW_STATUS=\$(curl -sf --max-time 5 "\${GATEWAY_URL}/health" || echo "unreachable")
                                    if echo "\$GW_STATUS" | grep -q "unreachable"; then
                                        echo "AIOps gateway unreachable — skipping AI analysis"
                                        exit 1
                                    fi

                                    python3 -c "
import json, os
summary = open('ai-summary.txt').read()
payload = json.dumps({'diff': summary, 'context': 'Nightly regression analysis'})
with open('ai-payload.json', 'w') as f:
    f.write(payload)
"

                                    RESPONSE=\$(curl -sf -X POST "\${GATEWAY_URL}/review" \
                                        -H "Content-Type: application/json" \
                                        -d @ai-payload.json \
                                        --max-time 60 \
                                        || echo '{"review":"Gateway unavailable"}')

                                    echo "\$RESPONSE" | python3 -c "
import json, sys
try:
    r = json.load(sys.stdin).get('review', '')
    print(r[:500])
except:
    print('Parse error')
" > ai-analysis.txt 2>/dev/null || true

                                    echo "=== AI Nightly Analysis ==="
                                    cat ai-analysis.txt
                                    echo "==========================="
                                """

                                env.AI_ANALYSIS = readFile('ai-analysis.txt').trim().take(400)
                            }
                        }
                    }
                }
            }
        }

        // ── Stage 10: Smoke Tests (conditional) ────────────────────────────
        stage('Smoke Tests') {
            when {
                expression {
                    def status = sh(
                        script: "curl -sf --max-time 5 ${APP_URL}/actuator/health > /dev/null 2>&1 && echo 'true' || echo 'false'",
                        returnStdout: true
                    ).trim()
                    env.APP_REACHABLE = status
                    return status == 'true'
                }
            }
            steps {
                script {
                    def checks = [
                        [path: '/actuator/health', expected: '200'],
                        [path: '/login',           expected: '200'],
                        [path: '/register',        expected: '200'],
                        [path: '/dashboard',       expected: '302'],
                    ]

                    def failed = []

                    checks.each { check ->
                        def status = sh(
                            script: "curl -s -o /dev/null -w '%{http_code}' --max-time 5 ${APP_URL}${check.path}",
                            returnStdout: true
                        ).trim()
                        if (status != check.expected) {
                            failed.add("${check.path}: expected ${check.expected}, got ${status}")
                        }
                    }

                    if (failed) {
                        currentBuild.result = 'UNSTABLE'
                        echo "Smoke test failures:\n${failed.join('\n')}"
                    } else {
                        echo "All smoke tests passed"
                    }

                    // E2E Login Flow: register → login → verify dashboard access
                    def e2eResult = sh(
                        script: """#!/bin/bash
                            set -e
                            APP="${APP_URL}"
                            USER="e2e_test_\$(date +%s)"
                            PASS="E2eTest1234"
                            JAR="/tmp/e2e_cookies.txt"

                            echo "=== E2E: Get CSRF token from /register ==="
                            CSRF=\$(curl -sf -c "\$JAR" "\$APP/register" | grep -oP 'name="_csrf" value="\\K[^"]+')
                            [ -z "\$CSRF" ] && echo "FAIL: No CSRF token on /register" && exit 1

                            echo "=== E2E: Register user \$USER ==="
                            HTTP=\$(curl -sf -b "\$JAR" -c "\$JAR" -o /dev/null -w '%{http_code}' \\
                              -X POST "\$APP/register" \\
                              -d "username=\$USER&password=\$PASS&_csrf=\$CSRF")
                            echo "Register response: \$HTTP"

                            echo "=== E2E: Get CSRF token from /login ==="
                            CSRF=\$(curl -sf -c "\$JAR" "\$APP/login" | grep -oP 'name="_csrf" value="\\K[^"]+')
                            [ -z "\$CSRF" ] && echo "FAIL: No CSRF token on /login" && exit 1

                            echo "=== E2E: Login as \$USER ==="
                            REDIRECT=\$(curl -sf -b "\$JAR" -c "\$JAR" -o /dev/null -w '%{redirect_url}' \\
                              -X POST "\$APP/login" \\
                              -d "username=\$USER&password=\$PASS&_csrf=\$CSRF")

                            if echo "\$REDIRECT" | grep -q '/dashboard'; then
                                echo "E2E Login OK: redirected to /dashboard"
                            else
                                echo "FAIL: Expected redirect to /dashboard, got: \$REDIRECT"
                                exit 1
                            fi

                            echo "=== E2E: Verify /dashboard accessible with session ==="
                            DASH=\$(curl -sf -b "\$JAR" -o /dev/null -w '%{http_code}' "\$APP/dashboard")
                            [ "\$DASH" = "200" ] && echo "E2E Dashboard OK: 200" || (echo "FAIL: dashboard returned \$DASH" && exit 1)

                            echo "=== E2E Login Flow PASSED ==="
                        """,
                        returnStatus: true
                    )
                    if (e2eResult != 0) {
                        currentBuild.result = 'UNSTABLE'
                        echo "E2E Login flow test FAILED"
                    }
                }
            }
        }

        // ── Stage 11: DAST Scan (ZAP) (conditional) ───────────────────────
        stage('DAST Scan (OWASP ZAP)') {
            when {
                expression {
                    return env.APP_REACHABLE == 'true'
                }
            }
            steps {
                container('zap') {
                    script {
                        sh 'mkdir -p zap-reports'

                        sh """
                            zap-baseline.py \
                              -t ${APP_URL} \
                              -r zap-reports/zap-report.html \
                              -J zap-reports/zap-report.json \
                              -w zap-reports/zap-report.md \
                              -c zap-config.conf \
                              -I \
                              -d \
                              || true
                        """

                        if (fileExists('zap-reports/zap-report.json')) {
                            def zapReport = readJSON file: 'zap-reports/zap-report.json'
                            def site = zapReport.site[0]

                            env.ZAP_CRITICAL = site.alerts.findAll { it.riskcode == "3" }.size().toString()
                            env.ZAP_HIGH     = site.alerts.findAll { it.riskcode == "2" }.size().toString()
                            env.ZAP_MEDIUM   = site.alerts.findAll { it.riskcode == "1" }.size().toString()
                            env.ZAP_LOW      = site.alerts.findAll { it.riskcode == "0" }.size().toString()

                            echo "ZAP: critical=${env.ZAP_CRITICAL} high=${env.ZAP_HIGH} medium=${env.ZAP_MEDIUM} low=${env.ZAP_LOW}"

                            if (env.ZAP_CRITICAL.toInteger() > 0) {
                                currentBuild.result = 'FAILURE'
                                error("Found ${env.ZAP_CRITICAL} CRITICAL vulnerabilities")
                            } else if (env.ZAP_HIGH.toInteger() > 0) {
                                currentBuild.result = 'UNSTABLE'
                            }
                        }
                    }
                }
            }
            post {
                always {
                    publishHTML(target: [
                        allowMissing: true,
                        alwaysLinkToLastBuild: true,
                        keepAll: true,
                        reportDir: 'zap-reports',
                        reportFiles: 'zap-report.html',
                        reportName: 'OWASP ZAP DAST Report'
                    ])
                    archiveArtifacts artifacts: 'zap-reports/*', allowEmptyArchive: true
                }
            }
        }

        // ── Stage 12: Pen Test — Nuclei (conditional) ────────────────────
        stage('Pen Test (Nuclei)') {
            when {
                expression {
                    return env.APP_REACHABLE == 'true'
                }
            }
            steps {
                container('nuclei') {
                    script {
                        sh 'mkdir -p nuclei-reports'

                        // Update templates to latest
                        sh 'nuclei -update-templates -silent 2>/dev/null || true'

                        // Run safe templates only — no DoS, no aggressive fuzzing
                        // Categories: cves, misconfigurations, exposures, default-logins, technologies
                        def exitCode = sh(
                            script: """
                                nuclei \
                                  -target ${APP_URL} \
                                  -tags cve,misconfig,exposure,default-login,tech \
                                  -exclude-tags dos,fuzz,intrusive \
                                  -severity critical,high,medium \
                                  -rate-limit 50 \
                                  -bulk-size 10 \
                                  -concurrency 5 \
                                  -timeout 10 \
                                  -retries 1 \
                                  -no-interactsh \
                                  -jsonl -output nuclei-reports/nuclei-results.jsonl \
                                  -markdown-export nuclei-reports/nuclei-results.md \
                                  -silent \
                                  || true
                            """,
                            returnStatus: true
                        )

                        // Parse results
                        if (fileExists('nuclei-reports/nuclei-results.jsonl')) {
                            def critical = sh(
                                script: "grep -c '\"severity\":\"critical\"' nuclei-reports/nuclei-results.jsonl || echo 0",
                                returnStdout: true
                            ).trim()
                            def high = sh(
                                script: "grep -c '\"severity\":\"high\"' nuclei-reports/nuclei-results.jsonl || echo 0",
                                returnStdout: true
                            ).trim()
                            def medium = sh(
                                script: "grep -c '\"severity\":\"medium\"' nuclei-reports/nuclei-results.jsonl || echo 0",
                                returnStdout: true
                            ).trim()

                            env.NUCLEI_CRITICAL = critical
                            env.NUCLEI_HIGH = high
                            env.NUCLEI_MEDIUM = medium

                            echo "Nuclei Pen Test: critical=${critical} high=${high} medium=${medium}"

                            if (critical.toInteger() > 0) {
                                currentBuild.result = 'FAILURE'
                                error("Nuclei found ${critical} CRITICAL vulnerabilities")
                            } else if (high.toInteger() > 0) {
                                currentBuild.result = 'UNSTABLE'
                            }
                        } else {
                            env.NUCLEI_CRITICAL = '0'
                            env.NUCLEI_HIGH = '0'
                            env.NUCLEI_MEDIUM = '0'
                            echo "Nuclei: no findings"
                        }
                    }
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: 'nuclei-reports/*', allowEmptyArchive: true
                }
            }
        }

        // ── Stage 13: Push Metrics ─────────────────────────────────────────
        stage('Push Metrics') {
            steps {
                catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                    container('tools') {
                        script {
                            def buildEnd = sh(
                                script: "date +%s",
                                returnStdout: true
                            ).trim()
                            def buildDuration = buildEnd.toLong() - (env.BUILD_START_EPOCH ?: buildEnd).toLong()

                            def buildStatus = '1'  // SUCCESS
                            if (currentBuild.result == 'UNSTABLE') buildStatus = '0.5'
                            if (currentBuild.result == 'FAILURE') buildStatus = '0'

                            def licenseVal = env.LICENSE_STATUS == 'PASS' ? '1' : '0'

                            def metrics = """
nightly_build_duration_seconds ${buildDuration}
nightly_build_status ${buildStatus}
nightly_unit_tests_total ${env.UNIT_TOTAL ?: 0}
nightly_unit_tests_failed ${env.UNIT_FAILED ?: 0}
nightly_integration_tests_total ${env.IT_TOTAL ?: 0}
nightly_integration_tests_failed ${env.IT_FAILED ?: 0}
nightly_coverage_percent ${env.COVERAGE_PERCENT ?: 0}
nightly_mutation_score_percent ${env.MUTATION_SCORE ?: 0}
nightly_owasp_cve_critical ${env.OWASP_CRITICAL ?: 0}
nightly_owasp_cve_high ${env.OWASP_HIGH ?: 0}
nightly_owasp_cve_medium ${env.OWASP_MEDIUM ?: 0}
nightly_k6_p95_ms ${env.K6_P95 ?: 0}
nightly_k6_rps ${env.K6_RPS ?: 0}
nightly_k6_error_rate ${env.K6_ERROR_RATE ?: 0}
nightly_zap_alerts_high ${env.ZAP_HIGH ?: 0}
nightly_zap_alerts_medium ${env.ZAP_MEDIUM ?: 0}
nightly_nuclei_critical ${env.NUCLEI_CRITICAL ?: 0}
nightly_nuclei_high ${env.NUCLEI_HIGH ?: 0}
nightly_nuclei_medium ${env.NUCLEI_MEDIUM ?: 0}
nightly_license_status ${licenseVal}
"""
                            writeFile file: 'nightly-metrics.txt', text: metrics.trim() + '\n'

                            sh """
                                cat nightly-metrics.txt
                                echo "---"
                                curl -s --max-time 10 \
                                  --data-binary @nightly-metrics.txt \
                                  ${PUSHGATEWAY_URL}/metrics/job/nightly \
                                  -w '\\nHTTP %{http_code}' \
                                  && echo " — Metrics pushed to Pushgateway" \
                                  || echo " — Pushgateway push failed"
                            """
                        }
                    }
                }
            }
        }

    } // end stages

    post {
        always {
            script {
                def duration = currentBuild.durationString.replace(' and counting', '')
                def status = currentBuild.result ?: 'SUCCESS'
                def emoji = status == 'SUCCESS' ? ':white_check_mark:' : (status == 'UNSTABLE' ? ':warning:' : ':x:')
                def statusColor = status == 'SUCCESS' ? '#36a64f' : (status == 'UNSTABLE' ? '#daa038' : '#dc3545')

                def smokeSection = env.APP_REACHABLE == 'true'
                    ? "*Smoke:* PASSED | *ZAP:* critical=${env.ZAP_CRITICAL ?: '0'} high=${env.ZAP_HIGH ?: '0'} medium=${env.ZAP_MEDIUM ?: '0'} | *Nuclei:* critical=${env.NUCLEI_CRITICAL ?: '0'} high=${env.NUCLEI_HIGH ?: '0'} medium=${env.NUCLEI_MEDIUM ?: '0'}"
                    : "*Smoke:* skipped (app offline) | *ZAP:* skipped | *Nuclei:* skipped"

                def aiSection = env.AI_ANALYSIS ? env.AI_ANALYSIS.take(300) : 'N/A (gateway unreachable)'

                container('tools') {
                    withCredentials([string(credentialsId: 'slack-webhook', variable: 'SLACK_HOOK_URL')]) {
                        def payload = """{
  "channel": "${env.SLACK_CHANNEL}",
  "attachments": [{
    "color": "${statusColor}",
    "blocks": [
      {"type": "header", "text": {"type": "plain_text", "text": "${emoji} Nightly Regression - ${status}"}},
      {"type": "section", "text": {"type": "mrkdwn", "text": "*Build:* #${env.BUILD_NUMBER} | *Commit:* ${env.GIT_COMMIT_SHORT ?: 'N/A'} | *Duration:* ${duration}"}},
      {"type": "section", "text": {"type": "mrkdwn", "text": "*Unit Tests:* ${env.UNIT_TOTAL ?: 'N/A'} total, ${env.UNIT_FAILED ?: 'N/A'} failed | *IT Tests:* ${env.IT_TOTAL ?: 'N/A'} total, ${env.IT_FAILED ?: 'N/A'} failed"}},
      {"type": "section", "text": {"type": "mrkdwn", "text": "*Coverage:* ${env.COVERAGE_PERCENT ?: 'N/A'}% | *Mutation Score:* ${env.MUTATION_SCORE ?: 'N/A'}%"}},
      {"type": "section", "text": {"type": "mrkdwn", "text": "*OWASP CVEs:* critical=${env.OWASP_CRITICAL ?: 'N/A'} high=${env.OWASP_HIGH ?: 'N/A'} medium=${env.OWASP_MEDIUM ?: 'N/A'} | *License:* ${env.LICENSE_STATUS ?: 'N/A'}"}},
      {"type": "section", "text": {"type": "mrkdwn", "text": "*k6 Performance:* p95=${env.K6_P95 ?: 'N/A'}ms | RPS=${env.K6_RPS ?: 'N/A'} | errors=${env.K6_ERROR_RATE ?: 'N/A'}%"}},
      {"type": "section", "text": {"type": "mrkdwn", "text": "${smokeSection}"}},
      {"type": "section", "text": {"type": "mrkdwn", "text": "*AI Analysis:* ${aiSection}"}},
      {"type": "section", "text": {"type": "mrkdwn", "text": "<${env.BUILD_URL}|View Reports>"}}
    ]
  }]
}"""
                        writeFile file: 'slack-nightly-payload.json', text: payload
                        sh 'curl -s -X POST "$SLACK_HOOK_URL" -H "Content-Type: application/json" -d @slack-nightly-payload.json || true'
                    }
                }
            }
        }

        success {
            echo 'Nightly regression pipeline completed successfully'
        }

        unstable {
            echo 'Nightly regression pipeline completed with warnings'
        }

        failure {
            echo 'Nightly regression pipeline failed'
        }
    }
}
